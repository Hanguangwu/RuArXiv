# SQLite for local development. Swap to a PostgreSQL URL for staging/production.
DATABASE_URL="file:./dev.db"

# 32+ char secret used to sign session cookies and local invite tokens.
AUTH_SECRET="dev-only-secret-change-me-please-0123456789"

# --- GitHub integration (optional) -------------------------------------------
# When GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET are absent the app runs in
# demo mode: local accounts, local content repository, local discussion store.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# GitHub App credentials (server-to-server + webhooks)
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_INSTALLATION_ID=""
GITHUB_WEBHOOK_SECRET=""
# Content repository that mirrors content/papers (owner/repo)
GITHUB_CONTENT_REPO=""
GITHUB_CONTENT_BRANCH="main"
