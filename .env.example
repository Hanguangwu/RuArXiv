# ---------------------------------------------------------------------------
# Database (Neon Postgres via Vercel Marketplace)
# ---------------------------------------------------------------------------
# Neon injects both values when the integration is connected:
#   DATABASE_URL           = pooled (PgBouncer) connection, used by the app
#   DATABASE_URL_UNPOOLED  = direct connection, used by `prisma migrate`
#
# For local development, either:
#   vercel link && vercel env pull .env
# or create a Neon project and paste the two connection strings below.
#
# Example (replace user/password/host/db):
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# 32+ char secret used to sign session cookies and local invite tokens.
AUTH_SECRET="dev-only-secret-change-me-please-0123456789"

# --- GitHub integration (optional) -------------------------------------------
# When GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET are absent the app runs in
# demo mode: local accounts, local content repository, local discussion store.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# GitHub App credentials (server-to-server + webhooks)
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_INSTALLATION_ID=""
GITHUB_WEBHOOK_SECRET=""
# Content repository that mirrors content/papers (owner/repo)
GITHUB_CONTENT_REPO=""
GITHUB_CONTENT_BRANCH="main"
GITHUB_REDIRECT_URI="http://localhost:3000/api/v1/auth/github/callback"

# --- Vercel Marketplace integrations (target; injected automatically) --------
# Upstash Redis: cache, rate limiting, idempotency keys.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
#
# Vercel Blob: PDF/images. Prefer OIDC (BLOB_STORE_ID + VERCEL_OIDC_TOKEN) on
# Vercel; BLOB_READ_WRITE_TOKEN is needed for client uploads and local dev.
# BLOB_READ_WRITE_TOKEN=""
#
# Optional shared secrets for cron/sync endpoints.
# CRON_SECRET=""
# SYNC_TOKEN=""
