{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruarxiv.dev/schemas/paper-metadata.schema.json",
  "title": "RuArXiv paper metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "authors", "categories", "license", "language", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z_-]{5,39}$",
      "description": "Immutable paper id. Directory name must be <id>-<slug>."
    },
    "title": { "type": "string", "minLength": 4, "maxLength": 240 },
    "abstract": { "type": "string", "maxLength": 6000 },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "login": { "type": "string", "pattern": "^[a-zA-Z0-9-]{1,39}$" },
          "orcid": { "type": "string", "maxLength": 32 },
          "affiliation": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2, "maxLength": 40 }
    },
    "keywords": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 60 }
    },
    "license": { "type": "string", "maxLength": 40 },
    "language": { "type": "string", "maxLength": 16 },
    "status": { "enum": ["draft", "review", "published", "hidden"] },
    "published_at": { "type": "string", "format": "date-time" },
    "source_url": { "type": "string", "format": "uri" },
    "pdf_url": { "type": "string", "format": "uri" },
    "discussion_issue": { "type": "integer", "minimum": 1 },
    "commit": { "type": "string", "maxLength": 64 },
    "pr": { "type": "integer", "minimum": 1 },
    "issue_url": { "type": "string", "format": "uri" }
  }
}
